#!/usr/bin/env bash
# stop-team — tear down a team: close its herdr workspace and remove its worktrees.
#
# Usage:
#   stop-team <team-name> [--force]
#
# Warns and asks for confirmation if any worktree has uncommitted changes or a
# branch that isn't merged into the project's current HEAD. --force skips the
# prompt and removes everything anyway.
set -euo pipefail

MUSTER_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$MUSTER_HOME/bin/lib.sh"

[[ $# -ge 1 ]] || muster_die "usage: stop-team <team-name> [--force]"
TEAM_NAME="$1"; shift
FORCE=""
[[ "${1:-}" == "--force" ]] && FORCE=1

STATE_FILE="$(muster_state_file "$TEAM_NAME")"
[[ -f "$STATE_FILE" ]] || muster_die "no state found for team '$TEAM_NAME' ($STATE_FILE)"

WORKSPACE_ID=$(jq -r '.workspace_id' "$STATE_FILE")
PROJECT_DIR=$(jq -r '.project_dir' "$STATE_FILE")

DIRTY=()
while IFS= read -r path; do
  [[ -z "$path" || "$path" == "null" || ! -d "$path" ]] && continue
  branch=$(git -C "$path" branch --show-current 2>/dev/null || echo "")
  if [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]]; then
    DIRTY+=("$path (uncommitted changes)")
  elif [[ -n "$branch" ]] && ! git -C "$PROJECT_DIR" merge-base --is-ancestor "$branch" HEAD 2>/dev/null; then
    DIRTY+=("$path (branch '$branch' has commits not merged into $(git -C "$PROJECT_DIR" branch --show-current))")
  fi
done < <(jq -r '.agents[].worktree_path' "$STATE_FILE")

if [[ ${#DIRTY[@]} -gt 0 && -z "$FORCE" ]]; then
  echo "stop-team: these worktrees have work that isn't merged/committed:" >&2
  printf '  - %s\n' "${DIRTY[@]}" >&2
  read -r -p "Remove anyway and discard that work? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || muster_die "aborted — nothing removed. Commit/merge the work above, or re-run with --force."
fi

echo "closing herdr workspace $WORKSPACE_ID" >&2
herdr workspace close "$WORKSPACE_ID" >/dev/null 2>&1 || echo "  (already closed, or not found)" >&2

while IFS=$'\t' read -r path branch; do
  [[ -z "$path" || "$path" == "null" ]] && continue
  if [[ -d "$path" ]]; then
    echo "removing worktree $path" >&2
    git -C "$PROJECT_DIR" worktree remove --force "$path" 2>/dev/null || rm -rf "$path"
  fi
  # Delete the branch too — worktree removal alone leaves it behind, which
  # collides with the next team that reuses this instance name (branch names
  # are deterministic: muster/<instance-name>). Safe at this point: we've
  # already confirmed above (or --force) that anything unmerged/uncommitted
  # was OK to discard.
  if [[ -n "$branch" && "$branch" != "null" ]] && git -C "$PROJECT_DIR" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$PROJECT_DIR" branch -D "$branch" >/dev/null 2>&1 && echo "removed branch $branch" >&2
  fi
done < <(jq -r '.agents[] | select(.worktree_path != "") | [.worktree_path, .branch] | @tsv' "$STATE_FILE")

rm -f "$STATE_FILE"
echo "team '$TEAM_NAME' stopped" >&2
